# ==========================================
# TechPulse Backend Configuration
# ==========================================

# 1. 9routers AI Gateway Settings
NINEROUTERS_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTERS_API_KEY=9router-local
AI_MODEL=gemini-2.5-flash

# 2. PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=mypassword
DB_NAME=nexo_dev
DB_SSLMODE=disable

# 3. Crawler & Scheduler Settings
CRAWL_INTERVAL_MINUTES=60
EMBEDDING_BACKFILL_INTERVAL_MINUTES=30
# Re-run the LLM on articles saved with the no-LLM fallback (flat 5.5, untranslated)
REANALYSIS_INTERVAL_MINUTES=15
AI_MAX_CONCURRENCY=4

# 4. Webhook Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# urgent_only: during the day only push articles scoring >= TELEGRAM_ALERT_THRESHOLD; all: old behavior
TELEGRAM_INSTANT_MODE=urgent_only
TELEGRAM_ALERT_THRESHOLD=8.0
TELEGRAM_ALERT_MAX_PER_DAY=3
# AI briefings: short updates (only articles since the previous briefing; skipped if none)
BRIEFING_UPDATE_HOURS=9,12,18
BRIEFING_MIN_SCORE=7.5
# Telegram alert when the AI gateway or crawling breaks (and again when it recovers)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MINUTES=15
HEALTH_WINDOW_MINUTES=60
HEALTH_STALE_HOURS=6
HEALTH_REMIND_HOURS=6
# End-of-day super summary (last 24h)
BRIEFING_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_BRIEFING_HOUR=22
DAILY_BRIEFING_MINUTE=0
MORNING_ESPRESSO_ENABLED=false
DISCORD_WEBHOOK_URL=
